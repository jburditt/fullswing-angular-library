{
  "name": "fullsweb-angular",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "prestart": "node aspnetcore-https",
    "start:windows": "ng s --port 4200 --ssl --ssl-cert \"%APPDATA%\\ASP.NET\\https\\%npm_package_name%.pem\" --ssl-key \"%APPDATA%\\ASP.NET\\https\\%npm_package_name%.key\" --host=127.0.0.1",
    "start:default": "ng s --port 4200 --ssl --ssl-cert \"$HOME/.aspnet/https/${npm_package_name}.pem\" --ssl-key \"$HOME/.aspnet/https/${npm_package_name}.key\" --host=127.0.0.1",
    "serve:ssr:fullswing-blog": "node dist/fullswing-blog/server/server.mjs",
    "deploy": "swa deploy ./dist/gamifyworkout/browser --api-location ./api --app-name stapp-gamifyworkout --env production --verbose silly",
    "deploy:local": "swa start ./dist/gamifyworkout/browser --api-location ./api"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^21.2.12",
    "@angular/build": "^21.2.11",
    "@angular/common": "^21.2.12",
    "@angular/compiler": "^21.2.12",
    "@angular/core": "^21.2.12",
    "@angular/forms": "^21.2.12",
    "@angular/material": "^21.2.10",
    "@angular/platform-browser": "^21.2.12",
    "@angular/platform-browser-dynamic": "^21.2.12",
    "@angular/platform-server": "^21.2.12",
    "@angular/router": "^21.2.12",
    "@angular/ssr": "^21.2.11",
    "@ngrx/signals": "^20.1.0",
    "@ngrx/store": "^20.0.1",
    "@ngworker/lumberjack": "^20.0.0",
    "@ngxpert/hot-toast": "^5.1.1",
    "angular-oauth2-oidc": "^17.0.1",
    "clipboard": "^2.0.11",
    "express": "^5.1.0",
    "marked": "^16.4.0",
    "ngx-markdown": "^20.1.0",
    "ngx-ui-loader": "^19.0.0",
    "odata-query": "^8.0.4",
    "prismjs": "^1.30.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.11",
    "@angular/cli": "^21.2.11",
    "@angular/compiler-cli": "^21.2.12",
    "@types/express": "^5.0.1",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^20.17.19",
    "jasmine-core": "~5.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ng-openapi-gen": "^0.53.0",
    "ng-packagr": "^21.2.3",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}